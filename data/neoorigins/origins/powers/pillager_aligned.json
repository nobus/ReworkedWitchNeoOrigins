{
    "name": "Pillager Aligned",
    "description": "Villagers don't like you, and pillagers like you!",
    "type": "origins:multiple",
    "no_trading_with_villagers": {
        "type": "origins:prevent_entity_use",
        "bientity_condition": {
            "type": "origins:target_condition",
            "condition": {
                "type": "origins:entity_type",
                "entity_type": "minecraft:villager"
            }
        }
    },
    "villager_loot": {
        "type": "origins:action_on_hit",
        "bientity_condition": {
            "type": "origins:target_condition",
            "condition": {
                "type": "origins:entity_type",
                "entity_type": "minecraft:villager"
            }
        },
        "bientity_action": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:if_else_list",
                "actions": [
                    {
                        "condition": {
                            "type": "origins:command",
                            "command": "execute if entity @s[nbt={VillagerData:{profession:\"minecraft:armorer\"}}]",
                            "comparison": ">=",
                            "compare_to": 1
                        },
                        "action": {
                            "type": "origins:execute_command",
                            "command": "data modify entity @s DeathLootTable set value \"witch:armorer\""
                        }
                    },
                    {
